# Windowed form
SELECT start, end, vehicle_id, COUNT(time_utc) AS events
FROM berlinmod GROUP BY vehicle_id
WINDOW TUMBLING(time_utc, SIZE 10 SEC)
INTO appeared;
----
1735711200000,1735711210000,100,5
1735711200000,1735711210000,200,5
1735711200000,1735711210000,300,5
1735711210000,1735711220000,100,2
1735711210000,1735711220000,200,2
1735711210000,1735711220000,300,2

# Snapshot form
SELECT start, end, vehicle_id, COUNT(time_utc) AS events
FROM berlinmod GROUP BY vehicle_id
WINDOW TUMBLING(time_utc, SIZE 5 SEC)
INTO appeared;
