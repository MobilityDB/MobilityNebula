# name: berlinmod/BerlinMOD_Q2.test
# description: BerlinMOD query 2, the trajectory of vehicle 200, in its three streaming forms: continuous (sliding windows of one second), windowed (tumbling windows of ten seconds) and snapshot (tumbling windows of five seconds), each the temporal point appendInstantAgg makes in a window from the vehicle's geodetic instants, tgeogpoint(tgeompoint(makePoint(gps_lon, gps_lat, 4326), time_utc)), as MobilityDB, MobilityDuck and MobilityFlink make them; asEWKT writes it. The input is the BerlinMOD sample of berlinmod/BerlinMOD_Q1.test.
# groups: [BerlinMOD, WindowOperators, Aggregation, MEOS, SpatioTemporal]
CREATE LOGICAL SOURCE berlinmod(time_utc UINT64 NOT NULL, vehicle_id UINT64 NOT NULL, gps_lon FLOAT64 NOT NULL, gps_lat FLOAT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR berlinmod TYPE File;
ATTACH INLINE
1735711200000,100,4.3517,50.8503
1735711200000,300,4.2000,50.7500
1735711201000,200,4.3060,50.8270
1735711202000,100,4.3517,50.8503
1735711202000,300,4.2000,50.7500
1735711203000,200,4.3060,50.8270
1735711204000,100,4.3517,50.8503
1735711204000,300,4.2000,50.7500
1735711205000,200,4.3060,50.8270
1735711206000,100,4.3517,50.8503
1735711206000,300,4.2000,50.7500
1735711207000,200,4.3060,50.8270
1735711208000,100,4.3517,50.8503
1735711208000,300,4.2000,50.7500
1735711209000,200,4.3060,50.8270
1735711210000,100,4.3517,50.8503
1735711210000,300,4.2000,50.7500
1735711211000,200,4.3060,50.8270
1735711212000,100,4.3517,50.8503
1735711212000,300,4.2000,50.7500
1735711213000,200,4.3060,50.8270

CREATE SINK trips(start UINT64 NOT NULL, end UINT64 NOT NULL, trajectory VARSIZED) TYPE File;

# Continuous form
SELECT start, end, asEWKT(appendInstantAgg(pos)) AS trajectory
FROM (SELECT time_utc, vehicle_id, tgeogpoint(tgeompoint(makePoint(gps_lon, gps_lat, INT32(4326)), time_utc)) AS pos FROM berlinmod)
WHERE vehicle_id == UINT64(200)
WINDOW SLIDING(time_utc, SIZE 1 SEC, ADVANCE BY 1 SEC)
INTO trips;
----
1735711201000,1735711202000,SRID=4326;[POINT(4.306 50.827)@2025-01-01 06:00:01+00]
1735711203000,1735711204000,SRID=4326;[POINT(4.306 50.827)@2025-01-01 06:00:03+00]
1735711205000,1735711206000,SRID=4326;[POINT(4.306 50.827)@2025-01-01 06:00:05+00]
1735711207000,1735711208000,SRID=4326;[POINT(4.306 50.827)@2025-01-01 06:00:07+00]
1735711209000,1735711210000,SRID=4326;[POINT(4.306 50.827)@2025-01-01 06:00:09+00]
1735711211000,1735711212000,SRID=4326;[POINT(4.306 50.827)@2025-01-01 06:00:11+00]
1735711213000,1735711214000,SRID=4326;[POINT(4.306 50.827)@2025-01-01 06:00:13+00]

# Windowed form
SELECT start, end, asEWKT(appendInstantAgg(pos)) AS trajectory
FROM (SELECT time_utc, vehicle_id, tgeogpoint(tgeompoint(makePoint(gps_lon, gps_lat, INT32(4326)), time_utc)) AS pos FROM berlinmod)
WHERE vehicle_id == UINT64(200)
WINDOW TUMBLING(time_utc, SIZE 10 SEC)
INTO trips;
----
1735711200000,1735711210000,SRID=4326;[POINT(4.306 50.827)@2025-01-01 06:00:01+00, POINT(4.306 50.827)@2025-01-01 06:00:09+00]
1735711210000,1735711220000,SRID=4326;[POINT(4.306 50.827)@2025-01-01 06:00:11+00, POINT(4.306 50.827)@2025-01-01 06:00:13+00]

# Snapshot form
SELECT start, end, asEWKT(appendInstantAgg(pos)) AS trajectory
FROM (SELECT time_utc, vehicle_id, tgeogpoint(tgeompoint(makePoint(gps_lon, gps_lat, INT32(4326)), time_utc)) AS pos FROM berlinmod)
WHERE vehicle_id == UINT64(200)
WINDOW TUMBLING(time_utc, SIZE 5 SEC)
INTO trips;
----
1735711200000,1735711205000,SRID=4326;[POINT(4.306 50.827)@2025-01-01 06:00:01+00, POINT(4.306 50.827)@2025-01-01 06:00:03+00]
1735711205000,1735711210000,SRID=4326;[POINT(4.306 50.827)@2025-01-01 06:00:05+00, POINT(4.306 50.827)@2025-01-01 06:00:09+00]
1735711210000,1735711215000,SRID=4326;[POINT(4.306 50.827)@2025-01-01 06:00:11+00, POINT(4.306 50.827)@2025-01-01 06:00:13+00]
