# name: berlinmod/BerlinMOD_Q3.test
# description: BerlinMOD query 3, which vehicles have been within 5 km of the point P, POINT(4.3517 50.8503), in its three streaming forms: continuous (sliding windows of one second), windowed (tumbling windows of ten seconds) and snapshot (tumbling windows of five seconds), each counting the events of each vehicle whose geodetic instant, tgeogpoint(tgeompoint(makePoint(gps_lon, gps_lat, 4326), time_utc)), eDwithin finds within the distance of the geography in metres on the spheroid, as MobilityFlink's MEOSBridge.dwithinMetres asks edwithin_tgeo_geo; the geography is read from its hex EWKB by geographyFromHexEWKB. The input is the BerlinMOD sample of berlinmod/BerlinMOD_Q1.test.
# groups: [BerlinMOD, WindowOperators, Aggregation, MEOS, SpatioTemporal]
CREATE LOGICAL SOURCE berlinmod(time_utc UINT64 NOT NULL, vehicle_id UINT64 NOT NULL, gps_lon FLOAT64 NOT NULL, gps_lat FLOAT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR berlinmod TYPE File;
ATTACH INLINE
1735711200000,100,4.3517,50.8503
1735711200000,300,4.2000,50.7500
1735711201000,200,4.3060,50.8270
1735711202000,100,4.3517,50.8503
1735711202000,300,4.2000,50.7500
1735711203000,200,4.3060,50.8270
1735711204000,100,4.3517,50.8503
1735711204000,300,4.2000,50.7500
1735711205000,200,4.3060,50.8270
1735711206000,100,4.3517,50.8503
1735711206000,300,4.2000,50.7500
1735711207000,200,4.3060,50.8270
1735711208000,100,4.3517,50.8503
1735711208000,300,4.2000,50.7500
1735711209000,200,4.3060,50.8270
1735711210000,100,4.3517,50.8503
1735711210000,300,4.2000,50.7500
1735711211000,200,4.3060,50.8270
1735711212000,100,4.3517,50.8503
1735711212000,300,4.2000,50.7500
1735711213000,200,4.3060,50.8270

CREATE SINK near(start UINT64 NOT NULL, end UINT64 NOT NULL, vehicle_id UINT64 NOT NULL, events_near_p UINT64 NOT NULL) TYPE File;

# Continuous form
SELECT start, end, vehicle_id, COUNT(time_utc) AS events_near_p
FROM (SELECT time_utc, vehicle_id, tgeogpoint(tgeompoint(makePoint(gps_lon, gps_lat, INT32(4326)), time_utc)) AS pos FROM berlinmod)
WHERE eDwithin(pos, geographyFromHexEWKB(VARSIZED('0101000020E61000004703780B24681140F7E461A1D66C4940')), FLOAT64(5000.0))
GROUP BY vehicle_id
WINDOW SLIDING(time_utc, SIZE 1 SEC, ADVANCE BY 1 SEC)
INTO near;
----
1735711200000,1735711201000,100,1
1735711201000,1735711202000,200,1
1735711202000,1735711203000,100,1
1735711203000,1735711204000,200,1
1735711204000,1735711205000,100,1
1735711205000,1735711206000,200,1
1735711206000,1735711207000,100,1
1735711207000,1735711208000,200,1
1735711208000,1735711209000,100,1
1735711209000,1735711210000,200,1
1735711210000,1735711211000,100,1
1735711211000,1735711212000,200,1
1735711212000,1735711213000,100,1
1735711213000,1735711214000,200,1

# Windowed form
SELECT start, end, vehicle_id, COUNT(time_utc) AS events_near_p
FROM (SELECT time_utc, vehicle_id, tgeogpoint(tgeompoint(makePoint(gps_lon, gps_lat, INT32(4326)), time_utc)) AS pos FROM berlinmod)
WHERE eDwithin(pos, geographyFromHexEWKB(VARSIZED('0101000020E61000004703780B24681140F7E461A1D66C4940')), FLOAT64(5000.0))
GROUP BY vehicle_id
WINDOW TUMBLING(time_utc, SIZE 10 SEC)
INTO near;
----
1735711200000,1735711210000,100,5
1735711200000,1735711210000,200,5
1735711210000,1735711220000,100,2
1735711210000,1735711220000,200,2

# Snapshot form
SELECT start, end, vehicle_id, COUNT(time_utc) AS events_near_p
FROM (SELECT time_utc, vehicle_id, tgeogpoint(tgeompoint(makePoint(gps_lon, gps_lat, INT32(4326)), time_utc)) AS pos FROM berlinmod)
WHERE eDwithin(pos, geographyFromHexEWKB(VARSIZED('0101000020E61000004703780B24681140F7E461A1D66C4940')), FLOAT64(5000.0))
GROUP BY vehicle_id
WINDOW TUMBLING(time_utc, SIZE 5 SEC)
INTO near;
----
1735711200000,1735711205000,100,3
1735711200000,1735711205000,200,2
1735711205000,1735711210000,100,2
1735711205000,1735711210000,200,3
1735711210000,1735711215000,100,2
1735711210000,1735711215000,200,2
