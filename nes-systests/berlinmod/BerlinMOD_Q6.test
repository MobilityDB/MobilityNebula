# Windowed form
SELECT start, end, vehicle_id, geoLength(appendInstantAgg(pos)) AS cumulative_distance
FROM (SELECT time_utc, vehicle_id, tgeogpoint(tgeompoint(makePoint(gps_lon, gps_lat, INT32(4326)), time_utc)) AS pos FROM berlinmod)
GROUP BY vehicle_id
WINDOW TUMBLING(time_utc, SIZE 10 SEC)
INTO distances;
