# name: berlinmod/BerlinMOD_Q6.test
# description: BerlinMOD query 6, the distance each vehicle travels, in its three streaming forms: continuous (sliding windows of one second), windowed (tumbling windows of ten seconds) and snapshot (tumbling windows of five seconds), each the length in metres on the spheroid, geoLength, of the trajectory appendInstantAgg makes in a window from the vehicle's geodetic instants, tgeogpoint(tgeompoint(makePoint(gps_lon, gps_lat, 4326), time_utc)), as main's TEMPORAL_LENGTH measures it. The input is the BerlinMOD sample of berlinmod/BerlinMOD_Q1.test with vehicles 100 and 200 moving, 0.001 degree east and 0.0005 degree north from one event to the next, and vehicle 300 standing, whose length is 0.
# groups: [BerlinMOD, WindowOperators, Aggregation, MEOS, SpatioTemporal]
CREATE LOGICAL SOURCE berlinmod(time_utc UINT64 NOT NULL, vehicle_id UINT64 NOT NULL, gps_lon FLOAT64 NOT NULL, gps_lat FLOAT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR berlinmod TYPE File;
ATTACH INLINE
1735711200000,100,4.3517,50.8503
1735711200000,300,4.2000,50.7500
1735711201000,200,4.3060,50.8270
1735711202000,100,4.3527,50.8503
1735711202000,300,4.2000,50.7500
1735711203000,200,4.3060,50.8275
1735711204000,100,4.3537,50.8503
1735711204000,300,4.2000,50.7500
1735711205000,200,4.3060,50.8280
1735711206000,100,4.3547,50.8503
1735711206000,300,4.2000,50.7500
1735711207000,200,4.3060,50.8285
1735711208000,100,4.3557,50.8503
1735711208000,300,4.2000,50.7500
1735711209000,200,4.3060,50.8290
1735711210000,100,4.3567,50.8503
1735711210000,300,4.2000,50.7500
1735711211000,200,4.3060,50.8295
1735711212000,100,4.3577,50.8503
1735711212000,300,4.2000,50.7500
1735711213000,200,4.3060,50.8300

CREATE SINK distances(start UINT64 NOT NULL, end UINT64 NOT NULL, vehicle_id UINT64 NOT NULL, cumulative_distance FLOAT64) TYPE File;

# Continuous form
SELECT start, end, vehicle_id, geoLength(appendInstantAgg(pos)) AS cumulative_distance
FROM (SELECT time_utc, vehicle_id, tgeogpoint(tgeompoint(makePoint(gps_lon, gps_lat, INT32(4326)), time_utc)) AS pos FROM berlinmod)
GROUP BY vehicle_id
WINDOW SLIDING(time_utc, SIZE 1 SEC, ADVANCE BY 1 SEC)
INTO distances;
