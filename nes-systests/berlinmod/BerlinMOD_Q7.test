# name: berlinmod/BerlinMOD_Q7.test
# description: BerlinMOD query 7, the first passage of each vehicle through each of three points of interest, in its three streaming forms: continuous (sliding windows of one second), windowed (tumbling windows of ten seconds) and snapshot (tumbling windows of five seconds), each the earliest time, MIN(time_utc), of the events of a vehicle whose geodetic instant, tgeogpoint(tgeompoint(makePoint(gps_lon, gps_lat, 4326), time_utc)), eDwithin finds within the radius of the point in metres on the spheroid: POI 1, POINT(4.3517 50.8503) within 2 km, POI 2, POINT(4.3060 50.8270) within 1 km, POI 3, POINT(4.2100 50.7600) within 2 km, the points of main's queries, read from their hex EWKB by geographyFromHexEWKB. The input is the BerlinMOD sample of berlinmod/BerlinMOD_Q1.test.
# groups: [BerlinMOD, WindowOperators, Aggregation, MEOS, SpatioTemporal]
CREATE LOGICAL SOURCE berlinmod(time_utc UINT64 NOT NULL, vehicle_id UINT64 NOT NULL, gps_lon FLOAT64 NOT NULL, gps_lat FLOAT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR berlinmod TYPE File;
ATTACH INLINE
1735711200000,100,4.3517,50.8503
1735711200000,300,4.2000,50.7500
1735711201000,200,4.3060,50.8270
1735711202000,100,4.3517,50.8503
1735711202000,300,4.2000,50.7500
1735711203000,200,4.3060,50.8270
1735711204000,100,4.3517,50.8503
1735711204000,300,4.2000,50.7500
1735711205000,200,4.3060,50.8270
1735711206000,100,4.3517,50.8503
1735711206000,300,4.2000,50.7500
1735711207000,200,4.3060,50.8270
1735711208000,100,4.3517,50.8503
1735711208000,300,4.2000,50.7500
1735711209000,200,4.3060,50.8270
1735711210000,100,4.3517,50.8503
1735711210000,300,4.2000,50.7500
1735711211000,200,4.3060,50.8270
1735711212000,100,4.3517,50.8503
1735711212000,300,4.2000,50.7500
1735711213000,200,4.3060,50.8270

CREATE SINK passages(start UINT64 NOT NULL, end UINT64 NOT NULL, vehicle_id UINT64 NOT NULL, first_passage_time UINT64 NOT NULL) TYPE File;

# POI 1, continuous form
SELECT start, end, vehicle_id, MIN(time_utc) AS first_passage_time
FROM (SELECT time_utc, vehicle_id, tgeogpoint(tgeompoint(makePoint(gps_lon, gps_lat, INT32(4326)), time_utc)) AS pos FROM berlinmod)
WHERE eDwithin(pos, geographyFromHexEWKB(VARSIZED('0101000020E61000004703780B24681140F7E461A1D66C4940')), FLOAT64(2000.0))
GROUP BY vehicle_id
WINDOW SLIDING(time_utc, SIZE 1 SEC, ADVANCE BY 1 SEC)
INTO passages;
----
1735711200000,1735711201000,100,1735711200000
1735711202000,1735711203000,100,1735711202000
1735711204000,1735711205000,100,1735711204000
1735711206000,1735711207000,100,1735711206000
1735711208000,1735711209000,100,1735711208000
1735711210000,1735711211000,100,1735711210000
1735711212000,1735711213000,100,1735711212000

# POI 1, windowed form
SELECT start, end, vehicle_id, MIN(time_utc) AS first_passage_time
FROM (SELECT time_utc, vehicle_id, tgeogpoint(tgeompoint(makePoint(gps_lon, gps_lat, INT32(4326)), time_utc)) AS pos FROM berlinmod)
WHERE eDwithin(pos, geographyFromHexEWKB(VARSIZED('0101000020E61000004703780B24681140F7E461A1D66C4940')), FLOAT64(2000.0))
GROUP BY vehicle_id
WINDOW TUMBLING(time_utc, SIZE 10 SEC)
INTO passages;
----
1735711200000,1735711210000,100,1735711200000
1735711210000,1735711220000,100,1735711210000

# POI 1, snapshot form
SELECT start, end, vehicle_id, MIN(time_utc) AS first_passage_time
FROM (SELECT time_utc, vehicle_id, tgeogpoint(tgeompoint(makePoint(gps_lon, gps_lat, INT32(4326)), time_utc)) AS pos FROM berlinmod)
WHERE eDwithin(pos, geographyFromHexEWKB(VARSIZED('0101000020E61000004703780B24681140F7E461A1D66C4940')), FLOAT64(2000.0))
GROUP BY vehicle_id
WINDOW TUMBLING(time_utc, SIZE 5 SEC)
INTO passages;
----
