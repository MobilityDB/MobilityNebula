WHERE eDwithin(pos, geographyFromHexEWKB(VARSIZED('0101000020E6100000D34D62105839114060E5D022DB694940')), FLOAT64(1000.0))
GROUP BY vehicle_id
WINDOW SLIDING(time_utc, SIZE 1 SEC, ADVANCE BY 1 SEC)
INTO passages;
