# name: MEOS_EContains_TGeo_TGeo
# description: eContains of two temporal geometries, as the catalog states it (a temporal point is never the container): a single-instant temporal geometry holding a point contains another at the same time iff they are equal. Both are read by tgeometryFromText.
# groups: [Function, MEOS, SpatioTemporal, TemporalGeometry, EContains]
CREATE LOGICAL SOURCE ect(id UINT32, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR ect TYPE File SET('|' AS INPUT_FORMATTER.FIELD_DELIMITER);
ATTACH INLINE
1|SRID=4326;POINT(4.3658 50.6456)@2021-01-01 00:00:00+00|SRID=4326;POINT(4.3658 50.6456)@2021-01-01 00:00:00+00
2|SRID=4326;POINT(4.3658 50.6456)@2021-01-01 00:00:00+00|SRID=4326;POINT(4.4 50.7)@2021-01-01 00:00:00+00

CREATE SINK ect_out(id UINT32, contains BOOLEAN) TYPE File;
SELECT id, eContains(tgeometryFromText(a), tgeometryFromText(b)) AS contains FROM ect INTO ect_out;
----
1,1
2,0
