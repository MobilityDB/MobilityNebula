# name: MEOS_EIntersects_TGeo_Linestring_Polygon
# description: eIntersects of a temporal point and a linestring, then a polygon, the temporal point read by tgeompointFromText and the geometries by geometryFromHexEWKB, the readers the catalog states.
# groups: [Function, MEOS, SpatioTemporal, TemporalGeometry, EIntersects]
CREATE LOGICAL SOURCE eil(id UINT32, trip VARSIZED);
CREATE PHYSICAL SOURCE FOR eil TYPE File SET('|' AS INPUT_FORMATTER.FIELD_DELIMITER);
ATTACH INLINE
1|SRID=4326;POINT(4 50)@2021-01-01 00:00:00+00
2|SRID=4326;POINT(9 9)@2021-01-01 00:00:00+00

CREATE SINK eil_out(id UINT32, intersects BOOLEAN) TYPE File;
SELECT id, eIntersects(tgeompointFromText(trip), geometryFromHexEWKB(VARSIZED('0102000020E6100000020000000000000000001040000000000000494000000000000014400000000000804940'))) AS intersects FROM eil INTO eil_out;
----
1,1
2,0

CREATE LOGICAL SOURCE eip(id UINT32, trip VARSIZED);
CREATE PHYSICAL SOURCE FOR eip TYPE File SET('|' AS INPUT_FORMATTER.FIELD_DELIMITER);
ATTACH INLINE
1|SRID=4326;POINT(4.5 50.5)@2021-01-01 00:00:00+00
2|SRID=4326;POINT(9 9)@2021-01-01 00:00:00+00

CREATE SINK eip_out(id UINT32, intersects BOOLEAN) TYPE File;
SELECT id, eIntersects(tgeompointFromText(trip), geometryFromHexEWKB(VARSIZED('0103000020E610000001000000050000000000000000001040000000000000494000000000000014400000000000004940000000000000144000000000008049400000000000001040000000000080494000000000000010400000000000004940'))) AS intersects FROM eip INTO eip_out;
----
1,1
2,0
