# name: MEOS_Aggregates
# description: The MEOS aggregates generated from the catalog, called by their names as in MobilityFlink and MobilityDuck, over a column of a MEOS type in a window; the answers are those of libmeos folding the same values, in time order, through the roles the catalog states for each aggregate. The rows of id 1 arrive out of time order, which appendInstantAgg, an aggregate with no combine, folds in time order.
# groups: [Aggregation, MEOS, SpatioTemporal]
CREATE LOGICAL SOURCE pings(id UINT64, pos TGEOMPOINT, ts UINT64);
CREATE PHYSICAL SOURCE FOR pings TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|012E0041E610000001010000006666666666661140CDCCCCCCCC6C494080364631CA5A0200|10000
2|012E0041E610000001010000000000000000001240000000000080494040EBF930CA5A0200|5000
1|012E0041E610000001010000009A99999999991140333333333373494080637732CA5A0200|30000
2|012E0041E6100000010100000033333333333312406666666666864940C0819231CA5A0200|15000
1|012E0041E6100000010100000085EB51B81E851140713D0AD7A370494000CDDE31CA5A0200|20000

CREATE SINK aggregates(pings.start UINT64, pings.end UINT64, pings.id UINT64, pings.n TINT, pings.merged TGEOMPOINT, pings.trip TGEOMPOINT) TYPE File;
SELECT start, end, id, tCount(pos) AS n, mergeAgg(pos) AS merged, appendInstantAgg(pos) AS trip
FROM pings GROUP BY id WINDOW TUMBLING(ts, size 1 minute) INTO aggregates;
