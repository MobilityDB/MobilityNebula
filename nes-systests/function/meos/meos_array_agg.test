# name: MEOS_ArrayAgg
# description: ARRAY_AGG(x) answers the values of x in a window, in the order the window met them, as the array of the type of x the MEOS plugin declares: a TGEOMPOINT gives a TGEOMPOINT_ARRAY, written as the text of its elements in braces. CROSS JOIN UNNEST reads the array back into the values it holds. The positions are those of function/meos/meos_aggregates.test, written as libmeos writes them (temporal_as_wkb with variant 4, in hex): vehicle 1 at 4.35 50.85 at 10 s, 4.4 50.9 at 30 s and 4.38 50.88 at 20 s, vehicle 2 at 4.5 51 at 5 s and 4.55 51.05 at 15 s. A type of no array is refused when the query is planned.
# groups: [Aggregation, WindowOperators, MEOS]
CREATE LOGICAL SOURCE pings(id UINT64, pos TGEOMPOINT, ts UINT64);
CREATE PHYSICAL SOURCE FOR pings TYPE File SET('|' AS INPUT_FORMATTER.FIELD_DELIMITER);
ATTACH INLINE
1|012E0041E610000001010000006666666666661140CDCCCCCCCC6C494080364631CA5A0200|10000
2|012E0041E610000001010000000000000000001240000000000080494040EBF930CA5A0200|5000
1|012E0041E610000001010000009A99999999991140333333333373494080637732CA5A0200|30000
2|012E0041E6100000010100000033333333333312406666666666864940C0819231CA5A0200|15000
1|012E0041E6100000010100000085EB51B81E851140713D0AD7A370494000CDDE31CA5A0200|20000

CREATE SINK arrays(start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64, positions TGEOMPOINT_ARRAY NOT NULL) TYPE File;
SELECT start, end, id, ARRAY_AGG(pos) AS positions
FROM pings GROUP BY id WINDOW TUMBLING(ts, size 1 minute) INTO arrays;
----
0,60000,1,{012E0041E610000001010000006666666666661140CDCCCCCCCC6C494080364631CA5A0200,012E0041E610000001010000009A99999999991140333333333373494080637732CA5A0200,012E0041E6100000010100000085EB51B81E851140713D0AD7A370494000CDDE31CA5A0200}
0,60000,2,{012E0041E610000001010000000000000000001240000000000080494040EBF930CA5A0200,012E0041E6100000010100000033333333333312406666666666864940C0819231CA5A0200}

CREATE SINK unnested(id UINT64, x TGEOMPOINT NOT NULL) TYPE File;
SELECT id, x
FROM (SELECT start, end, id, ARRAY_AGG(pos) AS positions FROM pings GROUP BY id WINDOW TUMBLING(ts, size 1 minute))
CROSS JOIN UNNEST(positions) AS u(x)
INTO unnested;
----
1,012E0041E610000001010000006666666666661140CDCCCCCCCC6C494080364631CA5A0200
1,012E0041E610000001010000009A99999999991140333333333373494080637732CA5A0200
1,012E0041E6100000010100000085EB51B81E851140713D0AD7A370494000CDDE31CA5A0200
2,012E0041E610000001010000000000000000001240000000000080494040EBF930CA5A0200
2,012E0041E6100000010100000033333333333312406666666666864940C0819231CA5A0200

CREATE SINK numbers(start UINT64 NOT NULL, end UINT64 NOT NULL, ids VARSIZED NOT NULL) TYPE File;
SELECT start, end, ARRAY_AGG(id) AS ids
FROM pings WINDOW TUMBLING(ts, size 1 minute) INTO numbers;
----
