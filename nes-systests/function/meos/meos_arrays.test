# name: MEOS_Arrays
# description: An array of MEOS values passed between MEOS functions, as MobilityFlink passes an ARRAY of a value class: instants answers the instants of a trip read from text, written as the hex WKB of each in braces, and tgeompointSeq reads them back into the linear sequence they make, with the length MEOS takes beside them; the answers are those of libmeos over the same values.
# groups: [Function, MEOS, SpatioTemporal]
CREATE LOGICAL SOURCE trips(id UINT32, trip VARSIZED);
CREATE PHYSICAL SOURCE FOR trips TYPE File SET('|' AS INPUT_FORMATTER.FIELD_DELIMITER);
ATTACH INLINE
1|SRID=4326;[POINT(4.35 50.85)@2021-01-01 00:00:00+00, POINT(4.40 50.90)@2021-01-01 00:10:00+00]
2|SRID=4326;[POINT(4.50 51.00)@2021-01-01 00:00:00+00, POINT(4.55 51.05)@2021-01-01 00:05:00+00, POINT(4.60 51.10)@2021-01-01 00:10:00+00]

CREATE SINK instants(id UINT32, points TGEOMPOINT_ARRAY) TYPE File;
SELECT id, instants(tgeompointFromText(trip)) AS points FROM trips INTO instants;
----
1,{012E0041E610000001010000006666666666661140CDCCCCCCCC6C494000A0AD30CA5A0200,012E0041E610000001010000009A99999999991140333333333373494000E67054CA5A0200}
2,{012E0041E610000001010000000000000000001240000000000080494000A0AD30CA5A0200,012E0041E610000001010000003333333333331240666666666686494000438F42CA5A0200,012E0041E610000001010000006666666666661240CDCCCCCCCC8C494000E67054CA5A0200}

CREATE SINK sequences(id UINT32, n INT32, trip TGEOMPOINT) TYPE File;
SELECT id, numInstants(tgeompointSeq(instants(tgeompointFromText(trip)))) AS n,
       tgeompointSeq(instants(tgeompointFromText(trip))) AS trip FROM trips INTO sequences;
----
1,2,012E004EE6100000020000000301010000006666666666661140CDCCCCCCCC6C494000A0AD30CA5A020001010000009A99999999991140333333333373494000E67054CA5A0200
2,3,012E004EE6100000030000000301010000000000000000001240000000000080494000A0AD30CA5A020001010000003333333333331240666666666686494000438F42CA5A020001010000006666666666661240CDCCCCCCCC8C494000E67054CA5A0200
