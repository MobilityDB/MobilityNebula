# name: MEOS_CellArrays
# description: Arrays of cells, which MEOS passes and answers as the contiguous 64-bit values a cell is, each element carried as a value of its type is, the hex of its WKB, in PostgreSQL's array text form: getValues answers the cells of an H3, a QUADBIN and an S2 cell set as such an array, and setMake makes the set back from it. The sets are the literals MobilityDB's tests use; the answers are those of libmeos over the same values (h3indexset_values, quadbinset_values and s2cellset_values with each cell written by its _as_wkb, variant 4; h3indexset_make, quadbinset_make and s2cellset_make, written by set_out).
# groups: [Function, MEOS]
CREATE LOGICAL SOURCE cells(id UINT32, h3 VARSIZED, qb VARSIZED, s2 VARSIZED);
CREATE PHYSICAL SOURCE FOR cells TYPE File SET('|' AS INPUT_FORMATTER.FIELD_DELIMITER);
ATTACH INLINE
1|{8a2a1072b59ffff, 831c02fffffffff, 880326b885fffff}|{480fffffffffffff, 48427fffffffffff}|{47c3c444c000000c, 47c3c444c0000004}

CREATE SINK cellValues(id UINT32, h3 H3INDEX_ARRAY, qb QUADBIN_ARRAY, s2 S2CELL_ARRAY) TYPE File;
SELECT id, getValues(h3indexsetFromText(h3)) AS h3, getValues(quadbinsetFromText(qb)) AS qb,
       getValues(s2cellsetFromText(s2)) AS s2
FROM cells INTO cellValues;
----
1,{01440040E6100000FFFFFFFF2FC03108,01440040E6100000FFFF5F886B328008,01440040E6100000FFFF592B07A1A208},{01470040E6100000FFFFFFFFFFFF0F48,01470040E6100000FFFFFFFFFF7F4248},{01550040E6100000040000C044C4C347,01550040E61000000C0000C044C4C347}

CREATE SINK cellSets(id UINT32, h3 VARSIZED, qb VARSIZED, s2 VARSIZED) TYPE File;
SELECT id, asText(setMake(getValues(h3indexsetFromText(h3)))) AS h3, asText(setMake(getValues(quadbinsetFromText(qb)))) AS qb,
       asText(setMake(getValues(s2cellsetFromText(s2)))) AS s2
FROM cells INTO cellSets;
----
1,{"831c02fffffffff", "880326b885fffff", "8a2a1072b59ffff"},{"480fffffffffffff", "48427fffffffffff"},{"47c3c444c0000004", "47c3c444c000000c"}
