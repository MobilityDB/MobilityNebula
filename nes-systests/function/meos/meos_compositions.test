# name: MEOS_Compositions
# description: The functions the catalog states as compositions of other MEOS functions, each built from its steps, as MobilityDB composes them in SQL: expandSpace(tgeompoint, float) expands the box of the point (tspatial_to_stbox, then stbox_expand_space); stboxXT(xmin, ymin, xmax, ymax, t [, srid]) makes the box of the span of t (timestamptz_to_span, then stbox_make with the literals the composition binds), the call without srid taking its default 0; eIntersects(tpose, geometry) and eDisjoint(tpose, tpose) answer for the temporal points the poses cast to. The answers are those of libmeos calling the same steps.
# groups: [MEOS, SpatioTemporal]
CREATE LOGICAL SOURCE points(id UINT64, pos TGEOMPOINT, ts UINT64);
CREATE PHYSICAL SOURCE FOR points TYPE File SET('|' AS INPUT_FORMATTER.FIELD_DELIMITER);
ATTACH INLINE
1|012E0051DB0B000001010000800000000080844E410000000060E34641000000000088B3400040EBA9C21C0000|978307200000
2|012E0051DB0B000001010000800000000038904E410000000028E446410000000000B4B44000C77EADC21C0000|978307260000

CREATE LOGICAL SOURCE poses(id UINT64, pose TPOSE);
CREATE PHYSICAL SOURCE FOR poses TYPE File SET('|' AS INPUT_FORMATTER.FIELD_DELIMITER);
ATTACH INLINE
1|0138000E0200000003010000000000000000000000000000000000000000000000000040EBA9C21C00000100000000000024400000000000003440000000000000F03F00A0C2C7D61C0000
2|0138000E0200000003010000000000005940000000000000594000000000000000000040EBA9C21C0000010000000000805B400000000000005E40000000000000F03F00A0C2C7D61C0000

CREATE SINK boxes(id UINT64, expanded STBOX, box STBOX, projected STBOX) TYPE File;
SELECT id, expandSpace(pos, 1000.0) AS expanded, stboxXT(1.0, 2.0, 3.0, 4.0, ts) AS box,
  stboxXT(1.0, 2.0, 3.0, 4.0, ts, INT32(3035)) AS projected
FROM points INTO boxes;
----
1 01190053DB0B00002700030040EBA9C21C00000040EBA9C21C0000000000008C824E410000000074864E41000000006CE146410000000054E54641000000000040AF40000000000070B740 011900032700030040EBA9C21C00000040EBA9C21C0000000000000000F03F000000000000084000000000000000400000000000001040 01190043DB0B00002700030040EBA9C21C00000040EBA9C21C0000000000000000F03F000000000000084000000000000000400000000000001040
2 01190053DB0B000027000300C77EADC21C000000C77EADC21C000000000000448E4E41000000002C924E410000000034E24641000000001CE646410000000000CCB04000000000009CB840 0119000327000300C77EADC21C000000C77EADC21C0000000000000000F03F000000000000084000000000000000400000000000001040 01190043DB0B000027000300C77EADC21C000000C77EADC21C0000000000000000F03F000000000000084000000000000000400000000000001040

CREATE SINK relationships(id UINT64, meets BOOLEAN, apart BOOLEAN) TYPE File;
SELECT id, eIntersects(pose, geometryFromHexEWKB('01030000000100000005000000000000000000F0BF000000000000F0BF000000000000F03F000000000000F0BF000000000000F03F000000000000F03F000000000000F0BF000000000000F03F000000000000F0BF000000000000F0BF')) AS meets,
  eDisjoint(pose, pose) AS apart
FROM poses INTO relationships;
----
1 1 0
2 0 0
