# name: MEOS_Functions
# description: The MEOS functions generated from the catalog, called by their SQL names as in MobilityDB and MobilityFlink, over values built from text in the query and over a column of a MEOS type; the answers are those of libmeos over the same values.
# groups: [Function, MEOS, SpatioTemporal]
CREATE LOGICAL SOURCE trips(id UINT32, trip VARSIZED);
CREATE PHYSICAL SOURCE FOR trips TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|SRID=4326;[POINT(4.35 50.85)@2021-01-01 00:00:00+00, POINT(4.40 50.90)@2021-01-01 00:10:00+00]
2|SRID=4326;[POINT(4.50 51.00)@2021-01-01 00:00:00+00, POINT(4.55 51.05)@2021-01-01 00:05:00+00, POINT(4.60 51.10)@2021-01-01 00:10:00+00]

CREATE SINK measures(trips.id UINT32, n INT32, len FLOAT64) TYPE File;
SELECT id, numInstants(tgeompointFromText(trip)) AS n, geoLength(tgeompointFromText(trip)) AS len FROM trips INTO measures;
----
1,2,0.07071067811865325
2,3,0.14142135623731025

CREATE SINK relations(trips.id UINT32, inside BOOLEAN, near BOOLEAN) TYPE File;
SELECT id,
       eIntersects(tgeompointFromText(trip), GEOMETRY('0103000020E61000000100000005000000333333333333114066666666666649407B14AE47E17A114066666666666649407B14AE47E17A11408FC2F5285C6F494033333333333311408FC2F5285C6F494033333333333311406666666666664940')) AS inside,
       EDWITHIN(tgeompointFromText(trip), GEOMETRY('0101000020E610000000000000000012400000000000804940'), 0.01) AS near
FROM trips INTO relations;
----
1,1,0
2,0,1

CREATE SINK starts(trips.id UINT32, start GEOMETRY) TYPE File;
SELECT id, startValue(tgeompointFromText(trip)) AS start FROM trips INTO starts;
----
1,0101000020E61000006666666666661140CDCCCCCCCC6C4940
2,0101000020E610000000000000000012400000000000804940

CREATE LOGICAL SOURCE speeds(id UINT32, speed TFLOAT);
CREATE PHYSICAL SOURCE FOR speeds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|0121000E0200000003000000000000F83F00A0AD30CA5A0200000000000000044000E67054CA5A0200

CREATE SINK speedMeasures(speeds.id UINT32, top FLOAT64, n INT32) TYPE File;
SELECT id, maxValue(speed) AS top, numinstants(speed) AS n FROM speeds INTO speedMeasures;
----
1,2.5,2
