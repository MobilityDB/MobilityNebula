# name: MEOS_InlineTableJoin
# description: The cross join of a stream with an inline table, FROM trips, (VALUES ...) AS f(fix, geom) and FROM trips CROSS JOIN (VALUES ...) AS f(fix, geom), as the holding fixes of London Heathrow join the flights in the queries of chapter 9: each trip once per fix, the name and the geometry of the fix in the fields fix and geom. Trip 1 is a sequence of SRID 3857 through (0 0) at 0 s, (10 0) at 1 s and (10 20) at 3 s; trip 2 is the single instant (5000 0) at 0 s. The fix Near is the point (10 5), on trip 1, and the fix Far the point (1000 1000). The answers of eDwithin within 10 m are libmeos's edwithin_tgeo_geo of each trip and fix; the second query keeps the pairs within 10 m.
# groups: [MEOS, SpatioTemporal]
CREATE LOGICAL SOURCE trips(id UINT64, trip TGEOMPOINT);
CREATE PHYSICAL SOURCE FOR trips TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|012E004E110F000003000000030101000000000000000000000000000000000000000040EBA9C21C00000101000000000000000000244000000000000000004082FAA9C21C0000010100000000000000000024400000000000003440C00619AAC21C0000
2|012E0041110F00000101000000000000000088B34000000000000000000040EBA9C21C0000

CREATE SINK fixes(trips.id UINT64, f.fix VARSIZED, near BOOLEAN) TYPE File;
SELECT id, fix, eDwithin(trip, geom, 10.0) AS near
FROM trips, (VALUES ('Near', geometryFromHexEWKB('0101000020110F000000000000000024400000000000001440')),
                    ('Far', geometryFromHexEWKB('0101000020110F00000000000000408F400000000000408F40'))) AS f(fix, geom)
INTO fixes;
----
1,Near,1
1,Far,0
2,Near,0
2,Far,0

CREATE SINK nearFixes(trips.id UINT64, f.fix VARSIZED) TYPE File;
SELECT id, fix
FROM trips CROSS JOIN (VALUES ('Near', geometryFromHexEWKB('0101000020110F000000000000000024400000000000001440')),
                              ('Far', geometryFromHexEWKB('0101000020110F00000000000000408F400000000000408F40'))) AS f(fix, geom)
WHERE eDwithin(trip, geom, 10.0)
INTO nearFixes;
----
1,Near
