# name: MEOS_IO
# description: A value of each MEOS family read from its text and written back through each format MobilityDB names, asText, asHexWKB, asBinary, the E forms of a type with an SRID and asMFJSON of a temporal type, and read back by the reader of that format; a row is kept where the text is the one libmeos writes and every format gives the value back.
# groups: [Function, MEOS]

CREATE LOGICAL SOURCE intsetValues(id UINT32, val VARSIZED);
CREATE PHYSICAL SOURCE FOR intsetValues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|{1, 2, 3}

CREATE SINK intsetRoundTrips(intsetValues.id UINT32) TYPE File;
SELECT id FROM intsetValues
WHERE asText(intsetFromText(val)) == VARSIZED("{1, 2, 3}")
  AND asText(intsetFromHexWKB(asHexWKB(intsetFromText(val)))) == asText(intsetFromText(val))
  AND asText(intsetFromBinary(asBinary(intsetFromText(val)))) == asText(intsetFromText(val))
INTO intsetRoundTrips;
----
1

