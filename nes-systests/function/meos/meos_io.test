ATTACH INLINE
1|TBOXFLOAT XT([1, 2],[2001-01-01, 2001-01-02])

CREATE SINK tboxRoundTrips(tboxValues.id UINT32) TYPE File;
SELECT id FROM tboxValues
WHERE asText(tboxFromText(val)) == VARSIZED("TBOXFLOAT XT([1, 2],[2001-01-01 00:00:00+00, 2001-01-02 00:00:00+00])")
  AND asText(tboxFromHexWKB(asHexWKB(tboxFromText(val)))) == asText(tboxFromText(val))
  AND asText(tboxFromBinary(asBinary(tboxFromText(val)))) == asText(tboxFromText(val))
