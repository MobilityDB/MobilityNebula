CREATE LOGICAL SOURCE stboxValues(id UINT32, val VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxValues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|SRID=4326;STBOX XT(((1,1),(2,2)),[2001-01-01, 2001-01-02])

CREATE SINK stboxRoundTrips(stboxValues.id UINT32) TYPE File;
SELECT id FROM stboxValues
WHERE asText(stboxFromText(val)) == VARSIZED("STBOX XT(((1,1),(2,2)),[2001-01-01 00:00:00+00, 2001-01-02 00:00:00+00])")
  AND asText(stboxFromHexWKB(asHexWKB(stboxFromText(val)))) == asText(stboxFromText(val))
  AND asText(stboxFromBinary(asBinary(stboxFromText(val)))) == asText(stboxFromText(val))
  AND asText(stboxFromEWKT(asEWKT(stboxFromText(val)))) == asText(stboxFromText(val))
  AND asText(stboxFromHexEWKB(asHexEWKB(stboxFromText(val)))) == asText(stboxFromText(val))
  AND asText(stboxFromEWKB(asEWKB(stboxFromText(val)))) == asText(stboxFromText(val))
INTO stboxRoundTrips;
----
1

