  AND asText(tstzspansetFromHexWKB(asHexWKB(tstzspansetFromText(val)))) == asText(tstzspansetFromText(val))
  AND asText(tstzspansetFromBinary(asBinary(tstzspansetFromText(val)))) == asText(tstzspansetFromText(val))
