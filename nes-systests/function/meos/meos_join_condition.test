# name: MEOS_Join_Condition
# description: The ON condition of a join holds every function a WHERE condition holds: the trips of each aircraft in each window of ten minutes, joined with themselves on the pairs whose boxes overlap once one is expanded by 1,000 m (stboxOverlaps(trip1, expandSpace(trip2, 1000.0))), kept where their nearest approach is under 1,000 m, the box filter and the distance of the close pairs of Sect. 9.4. Aircraft 1 and 2 pass 500 m apart in the first window; aircraft 2 and 4 pass 1,081.67 m apart in the second, their boxes overlapping, so the distance refuses them; aircraft 3 is far from all. The answers are those of libmeos over the same trips.
# groups: [Join, MEOS, SpatioTemporal]
CREATE LOGICAL SOURCE reports(id UINT64, pos TGEOMPOINT, ts UINT64);
CREATE PHYSICAL SOURCE FOR reports TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
