CREATE SINK pairs(reportsreports.start UINT64, id1 UINT64, id2 UINT64, distance FLOAT64) TYPE File;
SELECT start, id1, id2, nearestApproachDistance(trip1, trip2) AS distance
FROM (SELECT start, id AS id1, tgeompointSeq(instants(merged)) AS trip1
      FROM (SELECT start, end, id, mergeAgg(pos) AS merged FROM reports GROUP BY id WINDOW TUMBLING(ts, size 10 minutes)))
INNER JOIN (SELECT start, id AS id2, tgeompointSeq(instants(merged)) AS trip2
      FROM (SELECT start, end, id, mergeAgg(pos) AS merged FROM reports GROUP BY id WINDOW TUMBLING(ts, size 10 minutes)))
ON id1 > id2 AND stboxOverlaps(trip1, expandSpace(trip2, 1000.0))
WINDOW TUMBLING(start, size 10 minutes)
WHERE nearestApproachDistance(trip1, trip2) < FLOAT64(1000.0)
INTO pairs;
