# name: MEOS_MakePoint
# description: makePoint makes a geometry point from two columns of a stream and an SRID, in the order of PostGIS's ST_Point (x, y, srid), and from three columns in the order of ST_PointZ (x, y, z, srid); tgeompoint makes from it and a timestamp in milliseconds from the Unix epoch the temporal point asEWKT writes. The positions and times are three events of the BerlinMOD sample.
# groups: [Function, MEOS, SpatioTemporal, TemporalGeometry]
CREATE LOGICAL SOURCE positions(vehicle_id UINT64, time_utc UINT64, gps_lon FLOAT64, gps_lat FLOAT64);
CREATE PHYSICAL SOURCE FOR positions TYPE File;
ATTACH INLINE
100,1735711200000,4.3517,50.8503
200,1735711201000,4.3060,50.8270
300,1735711200000,4.2000,50.7500

CREATE SINK points(vehicle_id UINT64, trip VARSIZED) TYPE File;
SELECT vehicle_id, asEWKT(tgeompoint(makePoint(gps_lon, gps_lat, INT32(4326)), time_utc)) AS trip
FROM positions INTO points;
----
100,SRID=4326;POINT(4.3517 50.8503)@2025-01-01 06:00:00+00
200,SRID=4326;POINT(4.306 50.827)@2025-01-01 06:00:01+00
300,SRID=4326;POINT(4.2 50.75)@2025-01-01 06:00:00+00

SELECT vehicle_id, asEWKT(tgeompoint(makePoint(gps_lon, gps_lat, FLOAT64(10.0), INT32(3812)), time_utc)) AS trip
FROM positions INTO points;
----
100,SRID=3812;POINT Z (4.3517 50.8503 10)@2025-01-01 06:00:00+00
200,SRID=3812;POINT Z (4.306 50.827 10)@2025-01-01 06:00:01+00
300,SRID=3812;POINT Z (4.2 50.75 10)@2025-01-01 06:00:00+00
