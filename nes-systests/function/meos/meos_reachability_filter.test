CREATE SINK walked(reports.start UINT64, reports.end UINT64, reports.id UINT64, reports.trip TGEOMPOINT) TYPE File;
SELECT start, end, id, reachabilityFilterAgg(pos, 100.0) AS trip
FROM reports GROUP BY id WINDOW SESSION(ts, GAP 30 sec) INTO walked;
