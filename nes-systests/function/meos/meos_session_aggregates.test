# name: MEOS_SessionAggregates
# description: The MEOS aggregates over a session window per key, SESSION(ts, GAP 10 sec): the instants of id 1 at 10 s, 20 s and 30 s follow one another by exactly the gap, so they form one session [10 s, 40 s) across three slices, and those of id 2 at 5 s and 15 s one session [5 s, 25 s); each session holds the instants the one-minute tumbling window of meos_aggregates.test holds, so the answers are libmeos's answers there. The rows of id 1 arrive out of time order.
# groups: [Aggregation, MEOS, SpatioTemporal, WindowOperators]
CREATE LOGICAL SOURCE pings(id UINT64, pos TGEOMPOINT, ts UINT64);
CREATE PHYSICAL SOURCE FOR pings TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|012E0041E610000001010000006666666666661140CDCCCCCCCC6C494080364631CA5A0200|10000
2|012E0041E610000001010000000000000000001240000000000080494040EBF930CA5A0200|5000
1|012E0041E610000001010000009A99999999991140333333333373494080637732CA5A0200|30000
2|012E0041E6100000010100000033333333333312406666666666864940C0819231CA5A0200|15000
1|012E0041E6100000010100000085EB51B81E851140713D0AD7A370494000CDDE31CA5A0200|20000

CREATE SINK sessions(pings.start UINT64, pings.end UINT64, pings.id UINT64, pings.n TINT, pings.merged TGEOMPOINT, pings.trip TGEOMPOINT) TYPE File;
SELECT start, end, id, tCount(pos) AS n, mergeAgg(pos) AS merged, appendInstantAgg(pos) AS trip
FROM pings GROUP BY id WINDOW SESSION(ts, GAP 10 sec) INTO sessions;
