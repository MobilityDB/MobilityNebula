# name: MEOS_Timestamps
# description: A MEOS timestamptz carried as NebulaStream's timestamp, milliseconds from the Unix epoch, which MEOS converts with timestamptz_to_unix_us and unix_us_to_timestamptz. startTimestamp and endTimestamp read the first and last instants of a trip read from text, 2021-01-01 00:00:00 and 00:10:00 UTC, 1609459200000 and 1609459800000 ms; atTime reads a timestamp back into MEOS, so the trip restricted to its end timestamp starts at that timestamp. The answers are those of libmeos over the same values.
# groups: [Function, MEOS, SpatioTemporal]
CREATE LOGICAL SOURCE trips(id UINT32, trip VARSIZED);
CREATE PHYSICAL SOURCE FOR trips TYPE File SET('|' AS INPUT_FORMATTER.FIELD_DELIMITER);
ATTACH INLINE
1|SRID=4326;[POINT(4.35 50.85)@2021-01-01 00:00:00+00, POINT(4.40 50.90)@2021-01-01 00:10:00+00]
2|SRID=4326;[POINT(4.50 51.00)@2021-01-01 00:00:00+00, POINT(4.55 51.05)@2021-01-01 00:05:00+00, POINT(4.60 51.10)@2021-01-01 00:10:00+00]

CREATE SINK times(id UINT32, first UINT64, last UINT64, back UINT64) TYPE File;
SELECT id, startTimestamp(tgeompointFromText(trip)) AS first, endTimestamp(tgeompointFromText(trip)) AS last,
       startTimestamp(atTime(tgeompointFromText(trip), endTimestamp(tgeompointFromText(trip)))) AS back
FROM trips INTO times;
----
1,1609459200000,1609459800000,1609459800000
2,1609459200000,1609459800000,1609459800000
