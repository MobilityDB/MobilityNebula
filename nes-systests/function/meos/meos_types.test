# name: MEOS_Types
# description: A field of a MEOS type is read as the hex of its WKB, carried as the value's memory image and written as the upper-case hex MEOS writes: the lower-case hex of the second row comes back in upper case, which a field carrying its text would not do. The type is named regardless of case, and a text stating no value of the type is refused.
# groups: [Function, MEOS, DataType]
CREATE LOGICAL SOURCE mt(id UINT32, trip TGEOMPOINT, speed tfloat, box STBOX);
CREATE PHYSICAL SOURCE FOR mt TYPE File SET('|' AS INPUT_FORMATTER.FIELD_DELIMITER);
