# name: MEOS_Unnest
# description: FROM trips CROSS JOIN UNNEST(instants(trip)) AS u(x) gives each row once per instant of its trip, the instant in x, as SQL:2003 writes it and PostgreSQL, DuckDB and Flink read it. Trip 1 is a sequence of SRID 3857 through (0 0) at 0 s, (10 0) at 1 s and (10 20) at 3 s, which keeps its three instants; trip 2 is the single instant (5000 0) at 0 s. The second query keeps the instants of trip 1 alone, its WHERE reading a field of the relation before. The answers are libmeos's temporal_instants of each trip.
# groups: [MEOS, SpatioTemporal]
CREATE LOGICAL SOURCE trips(id UINT64, trip TGEOMPOINT);
CREATE PHYSICAL SOURCE FOR trips TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|012E004E110F000003000000030101000000000000000000000000000000000000000040EBA9C21C00000101000000000000000000244000000000000000004082FAA9C21C0000010100000000000000000024400000000000003440C00619AAC21C0000
2|012E0041110F00000101000000000000000088B34000000000000000000040EBA9C21C0000

CREATE SINK unnested(trips.id UINT64, u.x TGEOMPOINT) TYPE File;
SELECT id, x FROM trips CROSS JOIN UNNEST(instants(trip)) AS u(x) INTO unnested;
----
1,012E0041110F00000101000000000000000000000000000000000000000040EBA9C21C0000
1,012E0041110F00000101000000000000000000244000000000000000004082FAA9C21C0000
1,012E0041110F0000010100000000000000000024400000000000003440C00619AAC21C0000
2,012E0041110F00000101000000000000000088B34000000000000000000040EBA9C21C0000

CREATE SINK firstTrip(trips.id UINT64, u.x TGEOMPOINT) TYPE File;
SELECT id, x FROM trips CROSS JOIN UNNEST(instants(trip)) AS u(x) WHERE id = UINT64(1) INTO firstTrip;
----
1,012E0041110F00000101000000000000000000000000000000000000000040EBA9C21C0000
1,012E0041110F00000101000000000000000000244000000000000000004082FAA9C21C0000
1,012E0041110F0000010100000000000000000024400000000000003440C00619AAC21C0000
