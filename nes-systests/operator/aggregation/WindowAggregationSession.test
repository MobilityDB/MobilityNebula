# name: window/WindowAggregationSession.test
# description: A session window per key, SESSION(ts, GAP 10 sec): a key's session holds its records that follow one another by at most the gap, as Flink merges two session windows that touch, and its window is [first event time, last event time + gap). Key 1 goes on across a slice edge and at exactly the gap (24 s after 14 s), then starts again after 16 s of silence; key 2 is silent for 22 s between its two records; key 3 runs through five slices
# groups: [Aggregation, WindowOperators]

CREATE LOGICAL SOURCE stream(id UINT64, value UINT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH INLINE
1,1,1000
3,1,2000
2,1,3000
1,2,5000
3,2,11000
1,3,14000
3,3,20000
1,4,24000
2,2,25000
3,4,29000
3,5,38000
1,5,40000

CREATE SINK sessions(stream.start UINT64, stream.end UINT64, stream.id UINT64, stream.records UINT64, stream.total UINT64) TYPE File;
SELECT start, end, id, COUNT(value) AS records, SUM(value) AS total
FROM stream GROUP BY (id) WINDOW SESSION(ts, GAP 10 sec) INTO sessions;
----
1000,34000,1,4,10
40000,50000,1,1,5
3000,13000,2,1,1
25000,35000,2,1,2
2000,48000,3,5,15

# The same sessions with a watermark allowing a lateness, which the plan carries for a session window as for the others
SELECT start, end, id, COUNT(value) AS records, SUM(value) AS total
FROM stream GROUP BY (id) WINDOW SESSION(ts, GAP 10 sec) WATERMARK(ts, 20 sec) INTO sessions;
----
1000,34000,1,4,10
40000,50000,1,1,5
3000,13000,2,1,1
25000,35000,2,1,2
2000,48000,3,5,15
