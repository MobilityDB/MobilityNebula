CREATE SINK counts(events.start UINT64, events.end UINT64, events.id UINT64, events.n UINT64) TYPE File;
SELECT start, end, id, COUNT(ts) AS n FROM events GROUP BY id WINDOW TUMBLING(ts, size 10 sec) WATERMARK(ts, 10 sec) INTO counts;
