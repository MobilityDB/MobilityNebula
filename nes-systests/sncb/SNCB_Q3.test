CREATE SINK trajectories(start UINT64 NOT NULL, end UINT64 NOT NULL, device_id UINT64 NOT NULL, trajectory VARSIZED) TYPE File;
SELECT start, end, device_id, asEWKT(appendInstantAgg(pos)) AS trajectory
FROM (SELECT time_utc, device_id, tgeompoint(makePoint(gps_lon, gps_lat, INT32(4326)), time_utc) AS pos FROM sncb)
GROUP BY device_id
WINDOW TUMBLING(time_utc, SIZE 30 SEC)
INTO trajectories;
