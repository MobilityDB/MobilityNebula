# name: sncb/SNCB_Q3.test
# description: SNCB query 3, trajectory construction: the trajectory of each train, the temporal point of its readings, over tumbling windows of thirty seconds. The input is the SNCB sample of 3 trains and 37 readings, its times in milliseconds from the Unix epoch.
# groups: [SNCB, WindowOperators, Aggregation, MEOS, SpatioTemporal]
CREATE LOGICAL SOURCE sncb(time_utc UINT64 NOT NULL, device_id UINT64 NOT NULL, Vbat FLOAT64 NOT NULL, PCFA_mbar FLOAT64 NOT NULL, PCFF_mbar FLOAT64 NOT NULL, PCF1_mbar FLOAT64 NOT NULL, PCF2_mbar FLOAT64 NOT NULL, T1_mbar FLOAT64 NOT NULL, T2_mbar FLOAT64 NOT NULL, Code1 FLOAT64 NOT NULL, Code2 FLOAT64 NOT NULL, gps_speed FLOAT64 NOT NULL, gps_lat FLOAT64 NOT NULL, gps_lon FLOAT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR sncb TYPE File;
